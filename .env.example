# Copia este archivo a .env y cambia los valores. NUNCA subas .env al repo.
PORT=8088
LOG_LEVEL=info
# TRUST_PROXY=1

MONGO_URL=mongodb://analytics_svc:change-me-analytics@localhost:27017/analytics_db?authSource=analytics_db
AMQP_URL=amqp://festa:change-me-rabbit@localhost:5672
# Clave que firma el origen de los reintentos de la inbox (HMAC). OBLIGATORIA, aleatoria y estable (sin ella el
# servicio no arranca): ./scripts/gen-secrets.sh de festa-infra la genera y la entrega. Todas las réplicas deben
# compartirla. Sin valor de ejemplo a propósito: una clave pública anularía la firma. Local: openssl rand -hex 32
INBOX_RETRY_KEY=
JWT_ISSUER=festa-auth
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
# FESTA_CONTRACTS_DIR=../festa-infra/contracts


